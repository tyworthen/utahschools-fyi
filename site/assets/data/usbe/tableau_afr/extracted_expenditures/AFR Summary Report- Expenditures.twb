          <named-connection caption='upef-db-p-w1.usoe.k12.ut.us' name='sqlserver.1qmlo131lvshoe1c5l5m61jejjl3'>
            <connection authentication='sspi' class='sqlserver' dbname='upefs' odbc-native-protocol='yes' one-time-sql='/*Public Semantic Model&#10;Expenditure by Schedule, Fund, Function, Program, Object&#10;Edited by [redacted] Oct 2025*/&#10;&#10;--USE upefs&#10;&#10;SELECT distinct&#10;sd.YearId,&#10;CASE WHEN bs.agency_type = 1 THEN &apos;District&apos; ELSE &apos;Charter&apos; END AS &quot;Type&quot;,&#10;CASE WHEN bs.agency_type = 1 THEN &apos;1&apos; ELSE &apos;2&apos; END AS &quot;School_Type_Order&quot;,&#10;bs.district_id AS &quot;Dist_ID&quot;,&#10;bs.district_nbr AS &quot;Dist_Nbr&quot;,&#10;bs.school_id AS &quot;Sch_ID&quot;,&#10;bs.school_nbr AS &quot;Sch_Nbr&quot;,&#10;bs.school_name AS &quot;School_Name&quot;,&#10;sd.FundId,&#10;sd.FundCode,&#10;sd.FundDescription, &#10;CAST(sd.FundCode as varchar(4)) + &apos;- &apos; + sd.FundDescription AS &quot;Fund_Codeand_Description&quot;,&#10;CASE&#10;WHEN sd.FundCode between 10 and 49 or sd.FundCode = 51 THEN &apos;Governmental&apos;&#10;WHEN sd.FundCode = 50 or sd.FundCode between 52 and 69 THEN &apos;Proprietary&apos;&#10;WHEN sd.FundCode between 70 and 79 THEN &apos;Fiduciary&apos;&#10;ELSE &apos;UNKNOWN&apos;&#10;END AS &quot;Fund Type&quot;,&#10;CASE&#10;WHEN sd.FundCode like &apos;1%&apos; THEN &apos;10- General Fund&apos;&#10;WHEN sd.FundCode like &apos;2%&apos; THEN &apos;20- Special Revenue Funds&apos;&#10;WHEN sd.FundCode like &apos;3%&apos; THEN &apos;30- Debt Service and Capital Outlay Funds&apos;&#10;WHEN sd.FundCode like &apos;4%&apos; THEN &apos;40- Building Reserve Fund&apos;&#10;WHEN sd.FundCode like &apos;5%&apos; THEN &apos;50- Enterprise Funds&apos;&#10;WHEN sd.FundCode like &apos;6%&apos; THEN &apos;60- Internal Service Fund&apos;&#10;WHEN sd.FundCode like &apos;7%&apos; THEN &apos;70- Trust and Custodial Funds&apos;&#10;ELSE &apos;UNKNOWN&apos;&#10;END AS &quot;Fund Code Level 1&quot;,&#10;sd.FunctionId,&#10;sd.FunctionCode,&#10;CASE&#10;WHEN sd.FunctionCode like &apos;1%&apos; THEN &apos;1XXX- Instruction&apos;&#10;WHEN sd.FunctionCode like &apos;2%&apos; THEN &apos;2XXX- Support Services&apos;&#10;WHEN sd.FunctionCode like &apos;3%&apos; THEN &apos;3XXX- Operation of Noninstructional Services&apos;&#10;WHEN sd.FunctionCode like &apos;4%&apos; THEN &apos;4XXX- Facilities Acquisition and Construction Services&apos;&#10;WHEN sd.FunctionCode like &apos;5%&apos; THEN &apos;5XXX- Debt Service&apos;&#10;WHEN sd.FunctionCode like &apos;6%&apos; THEN &apos;6XXX- Other Uses&apos;&#10;WHEN sd.FunctionCode IS NULL THEN NULL&#10;ELSE &apos;UNKNOWN&apos;&#10;END AS &quot;Function Group 1d&quot;,&#10;CASE&#10;WHEN sd.FunctionCode like &apos;1%&apos; THEN &apos;1XXX- Instruction&apos;&#10;WHEN sd.FunctionCode like &apos;20%&apos; THEN &apos;20XX- Support Services&apos;&#10;WHEN sd.FunctionCode like &apos;21%&apos; THEN &apos;21XX- Support Services, Students&apos;&#10;WHEN sd.FunctionCode like &apos;22%&apos; THEN &apos;22XX- Support Services, Instructional Staff Support&apos;&#10;WHEN sd.FunctionCode like &apos;23%&apos; THEN &apos;23XX- Support Services, General District Administration&apos;&#10;WHEN sd.FunctionCode like &apos;24%&apos; THEN &apos;24XX- Support Services, School Administration&apos;&#10;WHEN sd.FunctionCode like &apos;25%&apos; THEN &apos;25XX- Central Business Services&apos;&#10;WHEN sd.FunctionCode like &apos;26%&apos; THEN &apos;26XX- Operation and Maintenance of Plant Services&apos;&#10;WHEN sd.FunctionCode like &apos;27%&apos; THEN &apos;27XX- Student Transportation Services&apos;&#10;WHEN (sd.FunctionCode like &apos;28%&apos; OR sd.FunctionCode like &apos;29%&apos;) THEN &apos;28XX/29XX- Other Support Services&apos;&#10;WHEN sd.FunctionCode like &apos;31%&apos; THEN &apos;31XX- Food Services&apos;&#10;WHEN sd.FunctionCode like &apos;32%&apos; THEN &apos;32XX- Enterprise Operations&apos;&#10;WHEN sd.FunctionCode like &apos;33%&apos; THEN &apos;33XX- Community Services&apos;&#10;WHEN (sd.FunctionCode like &apos;30%&apos; OR sd.FunctionCode like &apos;34%&apos; OR sd.FunctionCode like &apos;35%&apos; OR sd.FunctionCode like &apos;36%&apos; OR sd.FunctionCode like &apos;37%&apos; OR sd.FunctionCode like &apos;38%&apos; OR sd.FunctionCode like &apos;39%&apos;) THEN &apos;3XXX- Other Community Services&apos;&#10;WHEN sd.FunctionCode like &apos;4%&apos; THEN &apos;4XXX-Facilities Acquisition and Constuction Services&apos;&#10;WHEN sd.FunctionCode like &apos;5%&apos; THEN &apos;5XXX- Debt Service&apos;&#10;WHEN sd.FunctionCode like &apos;6%&apos; THEN &apos;6XXX- Other Uses&apos;&#10;WHEN sd.FunctionCode IS NULL THEN NULL&#10;ELSE &apos;UNKNOWN&apos;&#10;END AS &quot;Function Group 2d&quot;,&#10;sd.FunctionDescription,&#10;CAST(sd.FunctionCode as varchar(4)) + &apos;- &apos; + sd.FunctionDescription AS &quot;Function_Codeand_Description&quot;,&#10;sd.ProgramId,&#10;sd.ProgramCode,&#10;sd.ProgramDescription,&#10;CAST(sd.ProgramCode as varchar(4)) + &apos;- &apos; + sd.ProgramDescription AS &quot;Program_Codeand_Description&quot;,&#10;CASE &#10;WHEN sd.ObjectCode like &apos;1%&apos; THEN &apos;1XX- Salaries&apos;&#10;WHEN sd.ObjectCode like &apos;2%&apos; THEN &apos;2XX- Employee Benefits&apos;&#10;WHEN sd.ObjectCode like &apos;3%&apos; THEN &apos;3XX- Purchased Professional and Technical Services&apos;&#10;WHEN sd.ObjectCode like &apos;4%&apos; THEN &apos;4XX- Purchased Property Services&apos;&#10;WHEN sd.ObjectCode like &apos;5%&apos; THEN &apos;5XX- Other Purchased Services&apos;&#10;WHEN sd.ObjectCode like &apos;6%&apos; THEN &apos;6XX- Supplies and Materials&apos;&#10;WHEN sd.ObjectCode like &apos;7%&apos; THEN &apos;7XX- Property&apos;&#10;WHEN sd.ObjectCode like &apos;8%&apos; THEN &apos;8XX- Debt Service and Misc.&apos;&#10;WHEN sd.ObjectCode like &apos;9%&apos; THEN &apos;9XX- Other&apos;&#10;WHEN sd.ObjectCode IS NULL THEN NULL&#10;ELSE &apos;UNKNOWN&apos;&#10;END AS &quot;Object Grouping&quot;,&#10;sd.ObjectId,&#10;sd.ObjectCode,&#10;sd.ObjectDescription,&#10;CAST(sd.ObjectCode as varchar(4)) + &apos;- &apos; + sd.ObjectDescription AS &quot;Object_Codeand_Description&quot;,&#10;sd.Submission_Type,&#10;--case when sd.Amount is null then 0 else sd.Amount end as Amount&#10;sum(sd.Amount) as Amount&#10;&#10;FROM be_school AS bs&#10;INNER JOIN be_institution AS bi ON bs.school_id = bi.institution_id&#10;LEFT JOIN (&#10;SELECT&#10;&#9;&#9;&#9;s.YearId,&#10;&#9;&#9;&#9;sd.district_id,&#10;&#9;&#9;&#9;f.FundId,&#10;&#9;&#9;&#9;f.FundCode,&#10;&#9;&#9;&#9;f.FundDescription,&#10;&#9;&#9;&#9;fn.FunctionId,&#10;&#9;&#9;&#9;fn.FunctionCode,&#10;&#9;&#9;&#9;fn.FunctionDescription,&#10;&#9;&#9;&#9;p.ProgramId,&#10;&#9;&#9;&#9;p.ProgramCode,&#10;&#9;&#9;&#9;p.ProgramDescription,&#10;&#9;&#9;&#9;o.ObjectId,&#10;&#9;&#9;&#9;o.ObjectCode,&#10;&#9;&#9;&#9;o.ObjectDescription,&#10;&#9;&#9;&#9;CASE WHEN s.SubmissionTypeId = 1 THEN &apos;Original Budget&apos;&#10;&#9;&#9;&#9;WHEN s.SubmissionTypeId = 2 THEN &apos;Final Budget&apos;&#10;&#9;&#9;&#9;WHEN s.SubmissionTypeId = 3 THEN &apos;Actuals&apos;&#10;&#9;&#9;&#9;ELSE &apos;Other&apos;&#10;&#9;&#9;&#9;END AS &quot;Submission_Type&quot;,&#10;&#9;&#9;&#9;sd.Amount&#10;&#9;&#9;&#9;FROM SubmissionData AS sd&#10;&#9;&#9;&#9;INNER JOIN Submission AS s ON s.SubmissionId = sd.SubmissionId&#10;&#9;&#9;&#9;LEFT JOIN Fund AS f ON f.FundId = sd.FundId&#10;&#9;&#9;&#9;LEFT JOIN FunctionA AS fn ON fn.FunctionId = sd.FunctionId&#10;&#9;&#9;&#9;LEFT JOIN ObjectA AS o ON o.ObjectId = sd.ObjectId&#10;&#9;&#9;&#9;LEFT JOIN ProgramA AS p ON sd.ProgramId = p.ProgramId&#10;&#10;&#9;&#9;&#9;WHERE /*s.SubmissionTypeId = 3&#10;&#9;&#9;&#9;AND*/ o.ObjectCode IS NOT NULL&#10;&#9;&#9;&#9;AND fn.FunctionCode IS NOT NULL&#10;&#9;&#9;&#9;) AS sd ON sd.district_id = bs.district_id&#10;&#10;WHERE &#10;--bs.district_id &lt;&gt; bs.school_id&#10;--AND &#10;(bs.school_nbr = &apos;0&apos; + bs.district_nbr&#10;AND bs.school_type_code NOT IN ( &apos;ATC&apos;, &apos;SUPP&apos; )&#10;AND bs.agency_type IN (1,7)&#10;AND bs.school_type = 0&#10;AND bs.private_flag &lt;&gt; 1&#10;AND bs.federal_flag &lt;&gt; &apos;Y&apos;&#10;AND ( bi.state = &apos;UT&apos; OR bi.physical_state = &apos;UT&apos; )&#10;AND (bs.date_closed &gt;= (&#10;    SELECT y.BeginDate FROM Year AS y WHERE y.YearId = sd.YearId ) AND bs.date_opened &lt;=(SELECT y.BeginDate FROM Year AS y WHERE y.YearId = sd.YearId) ))&#10;--AND YearId = 2024 AND Submission_Type = &apos;Actuals&apos;&#10;&#10;GROUP BY sd.YearId, bs.agency_type, bs.district_id, bs.district_nbr, bs.school_nbr, bs.school_id, bs.school_name, &#10;sd.FundId, sd.FundCode, sd.FundDescription, sd.FunctionId, sd.FunctionCode, sd.FunctionDescription, &#10;sd.ProgramId, sd.ProgramCode, sd.ProgramDescription, &#10;sd.ObjectId, sd.ObjectCode, sd.ObjectDescription,&#10;sd.Submission_Type' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <relation connection='sqlserver.1qmlo131lvshoe1c5l5m61jejjl3' name='Custom SQL Query' type='text'><![CDATA[/*Public Semantic Model
Expenditure by Schedule, Fund, Function, Program, Object
Edited by [redacted] Oct 2025*/

--USE upefs

SELECT distinct
sd.YearId,
CASE WHEN bs.agency_type = 1 THEN 'District' ELSE 'Charter' END AS "Type",
CASE WHEN bs.agency_type = 1 THEN '1' ELSE '2' END AS "School_Type_Order",
bs.district_id AS "Dist_ID",
bs.district_nbr AS "Dist_Nbr",
bs.school_id AS "Sch_ID",
bs.school_nbr AS "Sch_Nbr",
bs.school_name AS "School_Name",
sd.FundId,
sd.FundCode,
sd.FundDescription, 
CAST(sd.FundCode as varchar(4)) + '- ' + sd.FundDescription AS "Fund_Codeand_Description",
CASE
WHEN sd.FundCode between 10 and 49 or sd.FundCode = 51 THEN 'Governmental'
WHEN sd.FundCode = 50 or sd.FundCode between 52 and 69 THEN 'Proprietary'
WHEN sd.FundCode between 70 and 79 THEN 'Fiduciary'
ELSE 'UNKNOWN'
END AS "Fund Type",
CASE
WHEN sd.FundCode like '1%' THEN '10- General Fund'
WHEN sd.FundCode like '2%' THEN '20- Special Revenue Funds'
WHEN sd.FundCode like '3%' THEN '30- Debt Service and Capital Outlay Funds'
WHEN sd.FundCode like '4%' THEN '40- Building Reserve Fund'
WHEN sd.FundCode like '5%' THEN '50- Enterprise Funds'
WHEN sd.FundCode like '6%' THEN '60- Internal Service Fund'
WHEN sd.FundCode like '7%' THEN '70- Trust and Custodial Funds'
ELSE 'UNKNOWN'
END AS "Fund Code Level 1",
sd.FunctionId,
sd.FunctionCode,
CASE
WHEN sd.FunctionCode like '1%' THEN '1XXX- Instruction'
WHEN sd.FunctionCode like '2%' THEN '2XXX- Support Services'
WHEN sd.FunctionCode like '3%' THEN '3XXX- Operation of Noninstructional Services'
WHEN sd.FunctionCode like '4%' THEN '4XXX- Facilities Acquisition and Construction Services'
WHEN sd.FunctionCode like '5%' THEN '5XXX- Debt Service'
WHEN sd.FunctionCode like '6%' THEN '6XXX- Other Uses'
WHEN sd.FunctionCode IS NULL THEN NULL
ELSE 'UNKNOWN'
END AS "Function Group 1d",
CASE
WHEN sd.FunctionCode like '1%' THEN '1XXX- Instruction'
WHEN sd.FunctionCode like '20%' THEN '20XX- Support Services'
WHEN sd.FunctionCode like '21%' THEN '21XX- Support Services, Students'
WHEN sd.FunctionCode like '22%' THEN '22XX- Support Services, Instructional Staff Support'
WHEN sd.FunctionCode like '23%' THEN '23XX- Support Services, General District Administration'
WHEN sd.FunctionCode like '24%' THEN '24XX- Support Services, School Administration'
WHEN sd.FunctionCode like '25%' THEN '25XX- Central Business Services'
WHEN sd.FunctionCode like '26%' THEN '26XX- Operation and Maintenance of Plant Services'
WHEN sd.FunctionCode like '27%' THEN '27XX- Student Transportation Services'
WHEN (sd.FunctionCode like '28%' OR sd.FunctionCode like '29%') THEN '28XX/29XX- Other Support Services'
WHEN sd.FunctionCode like '31%' THEN '31XX- Food Services'
WHEN sd.FunctionCode like '32%' THEN '32XX- Enterprise Operations'
WHEN sd.FunctionCode like '33%' THEN '33XX- Community Services'
WHEN (sd.FunctionCode like '30%' OR sd.FunctionCode like '34%' OR sd.FunctionCode like '35%' OR sd.FunctionCode like '36%' OR sd.FunctionCode like '37%' OR sd.FunctionCode like '38%' OR sd.FunctionCode like '39%') THEN '3XXX- Other Community Services'
WHEN sd.FunctionCode like '4%' THEN '4XXX-Facilities Acquisition and Constuction Services'
WHEN sd.FunctionCode like '5%' THEN '5XXX- Debt Service'
WHEN sd.FunctionCode like '6%' THEN '6XXX- Other Uses'
WHEN sd.FunctionCode IS NULL THEN NULL
ELSE 'UNKNOWN'
END AS "Function Group 2d",
CASE
WHEN sd.FunctionCode like '1%' THEN '1'
WHEN sd.FunctionCode like '20%' THEN '2'
WHEN sd.FunctionCode like '21%' THEN '3'
WHEN sd.FunctionCode like '22%' THEN '4'
WHEN sd.FunctionCode like '23%' THEN '5'
WHEN sd.FunctionCode like '24%' THEN '6'
WHEN sd.FunctionCode like '25%' THEN '7'
WHEN sd.FunctionCode like '26%' THEN '8'
WHEN sd.FunctionCode like '27%' THEN '9'
WHEN (sd.FunctionCode like '28%' OR sd.FunctionCode like '29%') THEN '10'
WHEN sd.FunctionCode like '31%' THEN '12'
WHEN sd.FunctionCode like '32%' THEN '13'
WHEN sd.FunctionCode like '33%' THEN '14'
WHEN (sd.FunctionCode like '30%' OR sd.FunctionCode like '34%' OR sd.FunctionCode like '35%' OR sd.FunctionCode like '36%' OR sd.FunctionCode like '37%' OR sd.FunctionCode like '38%' OR sd.FunctionCode like '39%') THEN '11'
WHEN sd.FunctionCode like '4%' THEN '15'
WHEN sd.FunctionCode like '5%' THEN '16'
WHEN sd.FunctionCode like '6%' THEN '17'
WHEN sd.FunctionCode IS NULL THEN NULL
ELSE 'UNKNOWN'
END AS "FunctionSortOrder",
sd.FunctionDescription,
CAST(sd.FunctionCode as varchar(4)) + '- ' + sd.FunctionDescription AS "Function_Codeand_Description",
sd.ProgramId,
sd.ProgramCode,
sd.ProgramDescription,
CAST(sd.ProgramCode as varchar(4)) + '- ' + sd.ProgramDescription AS "Program_Codeand_Description",
CASE 
WHEN sd.ObjectCode like '1%' THEN '1XX- Salaries'
WHEN sd.ObjectCode like '2%' THEN '2XX- Employee Benefits'
WHEN sd.ObjectCode like '3%' THEN '3XX- Purchased Professional and Technical Services'
WHEN sd.ObjectCode like '4%' THEN '4XX- Purchased Property Services'
WHEN sd.ObjectCode like '5%' THEN '5XX- Other Purchased Services'
WHEN sd.ObjectCode like '6%' THEN '6XX- Supplies and Materials'
WHEN sd.ObjectCode like '7%' THEN '7XX- Property'
WHEN sd.ObjectCode like '8%' THEN '8XX- Debt Service and Misc.'
WHEN sd.ObjectCode like '9%' THEN '9XX- Other'
WHEN sd.ObjectCode IS NULL THEN NULL
ELSE 'UNKNOWN'
END AS "Object Grouping",
CASE
	WHEN LEFT(sd.ObjectCode, 2) = 22 THEN '220 - Social Security Contributions'
	WHEN LEFT(sd.ObjectCode, 2) = 24 THEN '240 - Group Insurance'
	WHEN LEFT(sd.ObjectCode, 2) = 31 THEN '310 - Official/Administrative Services'
	WHEN LEFT(sd.ObjectCode, 2) = 32 THEN '320 - Professional Education Services'
	WHEN LEFT(sd.ObjectCode, 2) = 41 THEN '410 - Utility Services'
	WHEN LEFT(sd.ObjectCode, 2) = 42 THEN '420 - Cleaning Services'
	WHEN LEFT(sd.ObjectCode, 2) = 43 THEN '430 - Repairs & Maintenance Services'
	WHEN LEFT(sd.ObjectCode, 2) = 44 THEN '440 - Rentals'
	WHEN LEFT(sd.ObjectCode, 2) = 52 THEN '520 - Insurance (Other than employee benefits)'
	WHEN LEFT(sd.ObjectCode, 2) = 62 THEN '620 - Energy'
	WHEN LEFT(sd.ObjectCode, 2) = 64 THEN '640 - Books and Periodicals'
	WHEN LEFT(sd.ObjectCode, 2) = 68 THEN '680 - Maintenance Supplies and Materials'
	WHEN LEFT(sd.ObjectCode, 2) = 73 THEN '730 - Equipment'
	WHEN LEFT(sd.ObjectCode, 2) = 83 THEN '830 - Interest on Debt'
	WHEN LEFT(sd.ObjectCode, 2) = 84 THEN '840 - Redemption of Principal'
	ELSE Cast(sd.ObjectCode AS varchar(3)) + ' - ' + sd.ObjectDescription
	END AS "ObjectMandatory",
sd.ObjectId,
sd.ObjectCode,
sd.ObjectDescription,
CAST(sd.ObjectCode as varchar(4)) + '- ' + sd.ObjectDescription AS "Object_Codeand_Description",
sd.Submission_Type,
--case when sd.Amount is null then 0 else sd.Amount end as Amount
sum(sd.Amount) as Amount

FROM be_school AS bs
INNER JOIN be_institution AS bi ON bs.school_id = bi.institution_id
LEFT JOIN (
SELECT
			s.YearId,
			s.PublishedDate,
			sd.district_id,
			f.FundId,
			f.FundCode,
			f.FundDescription,
			fn.FunctionId,
			fn.FunctionCode,
			fn.FunctionDescription,
			p.ProgramId,
			p.ProgramCode,
			p.ProgramDescription,
			o.ObjectId,
			o.ObjectCode,
			o.ObjectDescription,
			CASE WHEN s.SubmissionTypeId = 1 THEN 'Original Budget'
			WHEN s.SubmissionTypeId = 2 THEN 'Final Budget'
			WHEN s.SubmissionTypeId = 3 THEN 'Actuals'
			ELSE 'Other'
			END AS "Submission_Type",
			sd.Amount
			FROM SubmissionData AS sd
			INNER JOIN Submission AS s ON s.SubmissionId = sd.SubmissionId
			LEFT JOIN Fund AS f ON f.FundId = sd.FundId
			LEFT JOIN FunctionA AS fn ON fn.FunctionId = sd.FunctionId
			LEFT JOIN ObjectA AS o ON o.ObjectId = sd.ObjectId
			LEFT JOIN ProgramA AS p ON sd.ProgramId = p.ProgramId

			WHERE /*s.SubmissionTypeId = 3
			AND*/ o.ObjectCode IS NOT NULL
			AND fn.FunctionCode IS NOT NULL
			AND s.PublishedDate IS NOT NULL
			) AS sd ON sd.district_id = bs.district_id

WHERE 
--bs.district_id <<>> bs.school_id
--AND 
(bs.school_nbr = '0' + bs.district_nbr
AND bs.school_type_code NOT IN ( 'ATC', 'SUPP' )
AND bs.agency_type IN (1,7)
AND bs.school_type = 0
AND bs.private_flag <<>> 1
AND bs.federal_flag <<>> 'Y'
AND ( bi.state = 'UT' OR bi.physical_state = 'UT' )
AND (bs.date_closed >>= (
    SELECT y.BeginDate FROM Year AS y WHERE y.YearId = sd.YearId ) AND bs.date_opened <<=(SELECT y.BeginDate FROM Year AS y WHERE y.YearId = sd.YearId) ))
--AND YearId = 2024 AND Submission_Type = 'Actuals'

GROUP BY sd.YearId, bs.agency_type, bs.district_id, bs.district_nbr, bs.school_nbr, bs.school_id, bs.school_name, 
sd.FundId, sd.FundCode, sd.FundDescription, sd.FunctionId, sd.FunctionCode, sd.FunctionDescription, 
sd.ProgramId, sd.ProgramCode, sd.ProgramDescription, 
sd.ObjectId, sd.ObjectCode, sd.ObjectDescription,
sd.Submission_Type]]></relation>
