            <column caption='District Nbr' datatype='string' name='[Calculation_2763239848748736516]' role='dimension' type='nominal' user:unnamed='Expenditures Data (Horizontal)'>
              <calculation class='tableau' formula='//District Nbr&#13;&#10;[Sch_Nbr]' />
            </column>
