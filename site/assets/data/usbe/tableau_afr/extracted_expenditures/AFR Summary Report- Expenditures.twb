          <metadata-record class='column'>
            <remote-name>Dist_ID</remote-name>
            <remote-type>131</remote-type>
            <local-name>[Dist_ID]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>Dist_ID</remote-alias>
