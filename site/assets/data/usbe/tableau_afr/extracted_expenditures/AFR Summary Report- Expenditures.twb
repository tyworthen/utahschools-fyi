            <column datatype='string' name='[Sch_Nbr]' role='dimension' type='nominal' />
            <column datatype='string' name='[School_Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[Submission_Type]' role='dimension' type='nominal' />
            <column datatype='string' name='[Type]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='YearId (limit Years filter)' datatype='integer' name='[YearId (copy)_3002212109699194880]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[YearId]' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[YearId]' role='dimension' type='ordinal' />
            <column-instance column='[School_Name]' derivation='Min' name='[min:School_Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2763239848748736516]' derivation='None' name='[none:Calculation_2763239848748736516:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2763239852351889419]' derivation='None' name='[none:Calculation_2763239852351889419:nk]' pivot='key' type='nominal' />
