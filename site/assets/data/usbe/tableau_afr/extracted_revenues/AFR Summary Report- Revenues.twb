      <object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_A9B410B4EB1E44F3BCFF11C2C73A880E'>
            <properties context=''>
              <relation connection='sqlserver.1gr3y2q1l975wx18ngz5u0krqijl' name='Custom SQL Query' type='text'><![CDATA[/*Public Semantic Model
Revenue by Schedule, Fund, RevCode
Edited by [redacted] Nov 2025*/
--USE upefs 

SELECT 
sd.YearId,
CASE WHEN bs.agency_type = 1 THEN 'District' ELSE 'Charter' END AS "Type",
bs.district_id AS "ID",
bs.district_nbr AS "Nbr",
bs.school_nbr AS "Sch_Nbr",
bs.school_name AS "School",
sd.FundId,
sd.FundCode,
sd.FundDescription,
CAST(sd.FundCode as varchar(4)) + '- ' + sd.FundDescription AS "FundCode_andDescription",
CASE
WHEN sd.FundCode between 10 and 49 or sd.FundCode = 51 THEN 'Governmental'
WHEN sd.FundCode = 50 or sd.FundCode between 52 and 69 THEN 'Proprietary'
WHEN sd.FundCode between 70 and 79 THEN 'Fiduciary'
ELSE 'UNKNOWN'
END AS "Fund Type",
CASE
WHEN sd.FundCode like '1%' THEN '10- General Fund'
WHEN sd.FundCode like '2%' THEN '20- Special Revenue Funds'
WHEN sd.FundCode like '3%' THEN '30- Debt Service and Capital Outlay Funds'
WHEN sd.FundCode like '4%' THEN '40- Building Reserve Fund'
WHEN sd.FundCode like '5%' THEN '50- Enterprise Funds'
WHEN sd.FundCode like '6%' THEN '60- Internal Service Fund'
WHEN sd.FundCode like '7%' THEN '70- Trust and Custodial Funds'
ELSE 'UNKNOWN'
END AS "Fund Code Level 1",
CASE 
WHEN sd.RevenueCode like '1%' THEN 'Local'
WHEN sd.RevenueCode like '2%' THEN 'Intermediate'
WHEN sd.RevenueCode like '3%' THEN 'State'
WHEN sd.RevenueCode like '4%' THEN 'Federal'
WHEN sd.RevenueCode like '5%' or sd.RevenueCode like '6%' THEN 'Other'
WHEN sd.RevenueCode IS NULL THEN NULL
ELSE 'UNKNOWN'
END AS "Revenue Source",
CASE 
WHEN sd.RevenueCode like '1%' THEN '1000- Revenue from Local Sources'
WHEN sd.RevenueCode like '2%' THEN '2000- Revenue from Intermediate Sources'
WHEN sd.RevenueCode like '3%' THEN '3000- Revenue from State Sources'
WHEN sd.RevenueCode like '4%' THEN '4000- Revenue from Federal Sources'
WHEN sd.RevenueCode like '5%' or sd.RevenueCode like '6%' THEN '5000- Other Financing Sources and Changes'
WHEN sd.RevenueCode IS NULL THEN NULL
ELSE 'UNKNOWN'
END AS "Revenue Code Group Level 1",
CASE 
WHEN sd.RevenueCode like '10%' THEN '10XX- '
WHEN sd.RevenueCode like '11%' THEN '11XX- '
WHEN sd.RevenueCode like '12%' THEN '12XX- '
WHEN sd.RevenueCode like '13%' THEN '13XX- '
WHEN sd.RevenueCode like '14%' THEN '14XX- '
WHEN sd.RevenueCode like '15%' THEN '15XX- '
WHEN sd.RevenueCode like '16%' THEN '16XX- '
WHEN sd.RevenueCode like '17%' THEN '17XX- '
WHEN sd.RevenueCode like '18%' THEN '18XX- '
WHEN sd.RevenueCode like '19%' THEN '19XX- '
WHEN sd.RevenueCode like '20%' THEN '20XX- '
WHEN sd.RevenueCode like '30%' THEN '30XX- '
WHEN sd.RevenueCode like '31%' THEN '31XX- '
WHEN sd.RevenueCode like '32%' THEN '32XX- '
WHEN sd.RevenueCode like '33%' THEN '33XX- '
WHEN sd.RevenueCode like '34%' THEN '34XX- '
WHEN sd.RevenueCode like '35%' THEN '35XX- '
WHEN sd.RevenueCode like '36%' THEN '36XX- '
WHEN sd.RevenueCode like '37%' THEN '37XX- '
WHEN sd.RevenueCode like '38%' THEN '38XX- '
WHEN sd.RevenueCode like '39%' THEN '39XX- '
WHEN sd.RevenueCode like '40%' THEN '40XX- '
WHEN sd.RevenueCode like '41%' THEN '41XX- '
WHEN sd.RevenueCode like '42%' THEN '42XX- '
WHEN sd.RevenueCode like '43%' THEN '43XX- '
WHEN sd.RevenueCode  like '44%' THEN '44XX- '
WHEN sd.RevenueCode  like '45%' THEN '45XX- '
WHEN sd.RevenueCode like '46%' THEN '46XX- '
WHEN sd.RevenueCode like '47%' THEN '47XX- '
WHEN sd.RevenueCode like '48%' THEN '48XX- '
WHEN sd.RevenueCode like '49%' THEN '49XX- '
WHEN sd.RevenueCode like '50%' THEN '50XX- '
WHEN sd.RevenueCode like '51%' THEN '51XX '
WHEN sd.RevenueCode like '52%' THEN '52XX- '
WHEN sd.RevenueCode like '53%' THEN '53XX- '
WHEN sd.RevenueCode like '54%' THEN '54XX- '
WHEN sd.RevenueCode like '55%' THEN '55XX- '
WHEN sd.RevenueCode like '56%' THEN '56XX- '
WHEN sd.RevenueCode like '57%' THEN '57XX- '
WHEN sd.RevenueCode like '58%' THEN '58XX- '
WHEN sd.RevenueCode like '59%' THEN '59XX- '
WHEN sd.RevenueCode like '60%' THEN '60XX- '
WHEN sd.RevenueCode like '61%' THEN '61XX- '
WHEN sd.RevenueCode like '62%' THEN '62XX- '
WHEN sd.RevenueCode like '63%' THEN '63XX- '
WHEN sd.RevenueCode like '64' THEN '64XX- '
WHEN sd.RevenueCode IS NULL THEN NULL
ELSE 'UNKNOWN'
END AS "Revenue Code Group Level 2",
sd.RevenueId,
sd.RevenueDescription,
sd.ParentId,
sd.ParentDescription,
sd.RevenueCode,
cast(sd.RevenueCode as varchar(4)) + '- ' + sd.RevenueDescription AS "RevCode_andDescription",
sd.ProgramId,
sd.ProgramCode,
sd.ProgramDescription,
CAST(sd.ProgramCode as varchar(4)) + '- ' + sd.ProgramDescription AS "Program_Codeand_Description",
sd.Submission_Type,
coalesce(sum("Rev Amount"),0) as "Revenue Amount"

FROM be_school AS bs

INNER JOIN be_institution AS bi ON bs.school_id = bi.institution_id

LEFT JOIN (
SELECT
			s.YearId,
			s.PublishedDate,
			sd.district_id,
			f.FundId,
			f.FundCode,
			f.FundDescription,
			fn.FunctionId,
			fn.FunctionCode,
			r.RevenueId,
			r.RevenueDescription,
			r2.ParentId,
			r2.RevenueDescription AS "ParentDescription",
			r.RevenueCode,
			o.ObjectId,
			o.ObjectCode,
			p.ProgramId,
			p.ProgramCode,
			p.ProgramDescription,
			CASE WHEN s.SubmissionTypeId = 1 THEN 'Original Budget'
			WHEN s.SubmissionTypeId = 2 THEN 'Final Budget'
			WHEN s.SubmissionTypeId = 3 THEN 'Actuals'
			ELSE 'Other'
			END AS "Submission_Type",
			sd.Amount AS "Rev Amount"

			FROM SubmissionData AS sd
			INNER JOIN Submission AS s ON s.SubmissionId = sd.SubmissionId
			LEFT JOIN Fund AS f ON f.FundId = sd.FundId
			LEFT JOIN Revenue AS r ON r.RevenueId = sd.RevenueId
			INNER JOIN Revenue as r2 ON r.ParentId = r2.RevenueId
			LEFT JOIN FunctionA AS fn ON fn.FunctionId = sd.FunctionId
			LEFT JOIN ObjectA AS o ON o.ObjectId = sd.ObjectId
			LEFT JOIN ProgramA AS p ON p.ProgramId = sd.ProgramId
			WHERE r.RevenueCode IS NOT NULL
			AND fn.FunctionCode IS NULL
			AND s.PublishedDate IS NOT NULL
			) AS sd ON sd.district_id = bs.district_id

WHERE (bs.school_nbr = '0' + bs.district_nbr
AND bs.school_type_code NOT IN ( 'ATC', 'SUPP' )
AND bs.agency_type IN (1,7)
AND bs.school_type = 0
--AND bs.district_id =122
AND bs.private_flag <<>> 1
AND bs.federal_flag <<>> 'Y'
AND ( bi.state = 'UT' OR bi.physical_state = 'UT' )
AND (bs.date_closed >>= (
    SELECT y.BeginDate FROM Year AS y WHERE y.YearId = sd.YearId  ) ))
AND sd.YearId IS NOT NULL
--AND YearId = 2024 AND Submission_Type = 'Actuals'

GROUP BY
	bs.district_nbr
	,bs.district_id
	,bs.school_nbr
	,bs.school_name
	,bs.agency_type
	,sd.YearId
	,sd.FundId
	,sd.FundCode
	,sd.FundDescription
	,sd.RevenueId
	,sd.RevenueDescription
	,sd.ParentId
	,sd.ParentDescription
	,sd.RevenueCode
	,sd.ProgramId
	,sd.ProgramCode
	,sd.ProgramDescription
	,sd.Submission_Type
--ORDER BY "Type", "School"]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </object-graph>
    </datasource>
  </datasources>
