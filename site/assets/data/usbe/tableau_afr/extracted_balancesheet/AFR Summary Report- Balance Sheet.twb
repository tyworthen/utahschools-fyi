      <connection class='federated'>
        <named-connections>
          <named-connection caption='upef-db-p-w1.usoe.k12.ut.us' name='sqlserver.0vlg3ha0bx4v8k1adahyb0so8bzt'>
            <connection authentication='sspi' class='sqlserver' dbname='upefs' odbc-native-protocol='yes' one-time-sql='' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <relation connection='sqlserver.0vlg3ha0bx4v8k1adahyb0so8bzt' name='Custom SQL Query' type='text'><![CDATA[/*Public Semantic Model
Balance Sheet by Fund, RevCode
Edited by [redacted] Oct 2025*/

SELECT distinct
sd.YearId,
CASE WHEN bs.agency_type = 1 THEN 'District' ELSE 'Charter' END AS "Type",
bs.district_id AS "ID",
bs.district_nbr AS "Nbr",
bs.school_nbr AS "Sch_Nbr",
bs.school_name AS "School",
sd.FundId,
sd.FundCode,
sd.FundDescription,
CAST(sd.FundCode as varchar(4)) + '- ' + sd.FundDescription AS "FundCode_andDescription",
CASE
WHEN sd.FundCode between 10 and 49 or sd.FundCode = 51 THEN 'Governmental'
WHEN sd.FundCode = 50 or sd.FundCode between 52 and 69 THEN 'Proprietary'
WHEN sd.FundCode between 70 and 79 THEN 'Fiduciary'
ELSE 'UNKNOWN'
END AS "Fund Type",
CASE
WHEN sd.FundCode like '1%' THEN '10- General Fund'
WHEN sd.FundCode like '2%' THEN '20- Special Revenue Funds'
WHEN sd.FundCode like '3%' THEN '30- Debt Service and Capital Outlay Funds'
WHEN sd.FundCode like '4%' THEN '40- Building Reserve Fund'
WHEN sd.FundCode like '5%' THEN '50- Enterprise Funds'
WHEN sd.FundCode like '6%' THEN '60- Internal Service Fund'
WHEN sd.FundCode like '7%' THEN '70- Trust and Custodial Funds'
ELSE 'UNKNOWN'
END AS "Fund Code Level 1",
CASE 
WHEN sd.BalanceSheetCode like '8%' THEN 'Assets'
WHEN sd.BalanceSheetCode between 9000 and 9799 THEN 'Liabilities'
WHEN sd.BalanceSheetCode between 9800 and 9999 THEN 'Fund Balance'
ELSE 'UNKNOWN'
END AS "Balance Sheet Code Level 1",
CASE 
WHEN sd.BalanceSheetCode between 8100 and 8199 THEN '81XX'
WHEN sd.BalanceSheetCode between 8200 and 8299 THEN '82XX'
WHEN sd.BalanceSheetCode between 8300 and 8399 THEN '83XX'
WHEN sd.BalanceSheetCode between 8400 and 8499 THEN '84XX'
WHEN sd.BalanceSheetCode between 9500 and 9599 THEN '95XX'
WHEN sd.BalanceSheetCode between 9600 and 9699 THEN '96XX'
WHEN sd.BalanceSheetCode between 9700 and 9799 THEN '97XX'
WHEN sd.BalanceSheetCode between 9800 and 9899 THEN '98XX'
WHEN sd.BalanceSheetCode between 9900 and 9999 THEN '99XX'
ELSE 'UNKNOWN'
END AS "Balance Sheet Code Level 2",
sd.BalanceSheetId,
sd.BalanceSheetCode,
CAST(sd.BalanceSheetCode as varchar(4)) + '- ' + sd.BalanceSheetDescription AS "BalSheetCode_andDescription",
sd.Submission_Type,
sum(sd.Amount) as Amount

FROM upefs.dbo.be_school AS bs
INNER JOIN upefs.dbo.be_institution AS bi ON bs.school_id = bi.institution_id
LEFT JOIN (
			SELECT
			s.YearId,
			s.PublishedDate,
			sd.district_id,
			f.FundId,
			f.FundCode,
			f.FundDescription,
			p.ProgramCode,
			p.ProgramDescription,
			r.RevenueCode,
			r.RevenueDescription,
			o.ObjectCode,
			bs.BalanceSheetId,
			bs.BalanceSheetCode,
			bs.BalanceSheetDescription,
			CASE WHEN s.SubmissionTypeId = 1 THEN 'Original Budget'
			WHEN s.SubmissionTypeId = 2 THEN 'Final Budget'
			WHEN s.SubmissionTypeId = 3 THEN 'Actuals'
			ELSE 'Other'
			END AS "Submission_Type",
			sd.Amount
			FROM upefs.dbo.SubmissionData AS sd
			INNER JOIN upefs.dbo.Submission AS s ON s.SubmissionId = sd.SubmissionId
			LEFT JOIN upefs.dbo.Fund AS f ON f.FundId = sd.FundId
			LEFT JOIN upefs.dbo.ProgramA AS p ON p.ProgramId = sd.ProgramId
			LEFT JOIN upefs.dbo.BalanceSheet AS bs ON bs.BalanceSheetId = sd.BalanceSheetId
			LEFT JOIN upefs.dbo.Revenue AS r ON r.RevenueId = sd.RevenueId
			LEFT JOIN upefs.dbo.FunctionA AS fn ON fn.FunctionId = sd.FunctionId
			LEFT JOIN upefs.dbo.ObjectA AS o ON o.ObjectId = sd.ObjectId
			WHERE s.CertifiedDate IS NOT NULL
			AND s.PublishedDate IS NOT NULL
			--s.SubmissionTypeId = 3
			AND bs.BalanceSheetCode IS NOT NULL
			AND o.ObjectCode IS NULL
			AND r.RevenueCode IS NULL
			--AND o.ObjectCode <<=890
			--AND f.FundCode IN ('49', '51')
			) AS sd ON sd.district_id = bs.district_id

WHERE (bs.school_nbr = '0' + bs.district_nbr
AND bs.school_type_code NOT IN ( 'ATC', 'SUPP' )
AND bs.agency_type IN (1,7)
AND bs.school_type = 0
AND bs.private_flag <<>> 1
AND bs.federal_flag <<>> 'Y'
AND ( bi.state = 'UT' OR bi.physical_state = 'UT' )
AND (bs.date_closed >>= (
    SELECT y.BeginDate FROM upefs.dbo.Year AS y WHERE y.YearId = sd.YearId ) AND bs.date_opened <<=(SELECT y.BeginDate FROM upefs.dbo.Year AS y WHERE y.YearId = sd.YearId) ))

GROUP BY sd.YearId, bs.agency_type, bs.district_id, bs.district_nbr, bs.school_nbr, bs.school_name, sd.FundId, sd.FundCode, sd.FundDescription, sd.BalanceSheetId, sd.BalanceSheetCode, sd.BalanceSheetDescription, sd.Submission_Type
--ORDER BY "Nbr"]]></relation>
