          </dictionary>
        </manual-sort>
        <manual-sort column='[none:Fund Type:nk]' direction='ASC'>
          <dictionary>
            <bucket>&quot;Governmental&quot;</bucket>
            <bucket>&quot;Fiduciary&quot;</bucket>
            <bucket>&quot;Proprietary&quot;</bucket>
          </dictionary>
        </manual-sort>
        <natural-sort column='[none:FundCode_andDescription:nk]' direction='ASC' />
      </default-sorts>
      <field-sort-info field-sort-order-type='custom-order'>
        <field-sort-custom-order field='YearId' />
        <field-sort-custom-order field='Calculation_2456713614001926147' />
